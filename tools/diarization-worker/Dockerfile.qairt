FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
RUN apt-get update -qq && apt-get install -y --no-install-recommends libatomic1 libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir numpy==1.26.4 onnx==1.19.1 onnxruntime==1.23.2 PyYAML==6.0.2 setuptools==75.6.0
ENV PYTHONPATH=/sdk/lib/python
ENV LD_LIBRARY_PATH=/sdk/lib/aarch64-oe-linux-gcc11.2
